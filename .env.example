# X-SOVEREIGN Unified Terminal Environment Variables
# Copy this file to .env and replace the placeholders with your actual keys.

# Gemini AI Key (for OMNIBRAIN Market Scan & Valuations)
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# Groq Key (if configured for deterministic fast endpoints)
GROQ_API_KEY=<YOUR_GROQ_API_KEY>

# Stripe Payment Integration (Test Mode or Live Mode)
STRIPE_SECRET_KEY=<YOUR_STRIPE_SECRET_KEY>

# Application Port
PORT=3000

# Backend Database Path
DATABASE_PATH=data/brain.db
